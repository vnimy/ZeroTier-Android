<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ZeroTier" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 状态栏透明：edge-to-edge 下由标题栏背景铺满状态栏区域 -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <!-- Customize your theme here. -->
        <item name="greyText">@color/grey_text_night</item>
        <item name="lightGreyText">@color/light_grey_text_night</item>
        <item name="tableRowGrey">@color/table_row_grey_night</item>
    </style>

    <!-- 夜间：弹窗背景来自深色主题，文字必须是浅色，否则黑底黑字 -->
    <style name="Theme.ZeroTier.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />
</resources>