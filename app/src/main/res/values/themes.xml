<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ZeroTier" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color: 官方 ZeroTier 橙色 -->
        <item name="colorPrimary">@color/zerotier_orange</item>
        <item name="colorPrimaryVariant">@color/zerotier_orange_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color: 官方开关的深青色 -->
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏透明：edge-to-edge 下由标题栏背景铺满状态栏区域 -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <!-- Customize your theme here. -->
        <item name="greyText">@color/grey_text</item>
        <item name="lightGreyText">@color/light_grey_text</item>
        <item name="tableRowGrey">@color/table_row_grey</item>
    </style>

    <style name="Theme.ZeroTier.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ZeroTier.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- 橙色标题栏上的标题、返回箭头和溢出菜单图标统一使用深色 -->
    <style name="ThemeOverlay.ZeroTier.Toolbar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorControlNormal">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
    </style>
</resources>